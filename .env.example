# Supabase project URL (e.g. https://<project-ref>.supabase.co)
SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase anonymous key (safe to use client-side)
SUPABASE_ANON_KEY=<anon-key>
# JWT secret used to verify Supabase tokens (keep secret)
SUPABASE_JWT_SECRET=<jwt-secret>
# HTTP server port
SERVER_PORT=8080
# Log level: debug, info, warn, error
LOG_LEVEL=info
# Anthropic API key injected into the `claude` subprocess by run-agent (Task 0008)
ANTHROPIC_API_KEY=sk-ant-...
